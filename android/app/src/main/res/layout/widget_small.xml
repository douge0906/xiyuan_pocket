<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课表小组件 · 小尺寸（2×1）：白底圆角，三行显示下一节课。
     2026-10-12 改版：原来两行是「课程名 / 时间 教室」挤在一行，
     现在拆成三行 —— 课程名 / 时间 / 教室，一行一件事。
     ⚠️ 三行比两行高，minHeight 相应提到 60dp（见 widget_small_info.xml）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_bg_light"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_icon_dark"
        android:contentDescription="掌上锡院" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1F2937"
            android:text="下一节" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#667085"
            android:text="周三 · 第3周" />

        <TextView
            android:id="@+id/widget_next_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#667085" />
    </LinearLayout>
</LinearLayout>
